    "average_auprc_harm_floor": -0.002,
    "maximum_routing_flip_rate": 0.1
  },
  "ablation_tests": {
    "no_contract": {
      "metric": "cvar_regret",
      "direction": "lower",
      "minimum_effect": 0.001,
      "required_contribution": true
