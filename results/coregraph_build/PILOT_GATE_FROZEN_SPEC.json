    "auprc": -0.002,
    "recall_at_0.5pct": 0.0,
    "recall_at_1pct": 0.0,
    "recall_at_2pct": 0.0,
    "budget_curve_area": 0.001,
    "mean_regret": 0.001,
    "maximum_regret": 0.001,
    "cvar_regret": 0.001,
    "selective_risk": 0.001,
    "abstention_cost": 0.0,
    "compute": 0.0
