      "direction": "higher",
      "minimum_effect": 0.0,
      "required_contribution": false
    },
    "no_abstention": {
      "metric": "selective_risk",
      "direction": "lower",
      "minimum_effect": 0.0,
      "required_contribution": false
    },
    "no_diagnostics": {
      "metric": "auprc",
      "direction": "higher",
      "minimum_effect": 0.0,
      "required_contribution": false
    }
  },
  "required_meaningful_ablations": [
    "no_contract",
    "atomic_contract",
    "no_regret",
    "no_budget",
    "no_resource_mask"
  ],
  "headline_oracle": "contract_feasible_oracle",
  "diagnostic_oracle": "instance_clairvoyant_oracle_ceiling",
  "inferential_block": "expert_prediction_seed",
  "router_training_seed_role": "deterministic_method_specific_secondary_seed_not_an_inferential_block",
  "matched_worst_case": "minimum_within_seed_of_method_minus_baseline_effects_on_identical_target_contracts",
  "target_labels_for_selection": false,
  "blocked_prediction_ordering": "PROHIBITED",
  "zero_coverage_selective_risk": "UNDEFINED_AND_GATE_BLOCKING"
}
