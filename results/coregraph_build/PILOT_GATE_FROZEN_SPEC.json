    "atomic_contract": {
      "metric": "cvar_regret",
      "direction": "lower",
      "minimum_effect": 0.001,
      "required_contribution": true
    },
    "no_regret": {
      "metric": "cvar_regret",
      "direction": "lower",
      "minimum_effect": 0.001,
      "required_contribution": true
    },
    "no_budget": {
      "metric": "budget_curve_area",
      "direction": "higher",
      "minimum_effect": 0.001,
      "required_contribution": true
    },
    "no_resource_mask": {
      "metric": "cvar_regret",
      "direction": "lower",
      "minimum_effect": 0.001,
      "required_contribution": true
    },
    "no_stability": {
