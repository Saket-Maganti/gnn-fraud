    "abstention_cost",
    "compute"
  ],
  "primary_outcomes": [
    "auprc",
    "recall_at_0.5pct",
    "recall_at_1pct",
    "recall_at_2pct",
    "budget_curve_area",
    "mean_regret",
    "maximum_regret",
    "cvar_regret",
    "selective_risk",
    "abstention_cost",
    "compute"
  ],
  "ranking_outcomes": [
    "auprc",
    "recall_at_0.5pct",
    "recall_at_1pct",
    "recall_at_2pct",
