\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Elliptic Bitcoin Dataset summary. The 7.6:1 training imbalance and the dramatic variation in test-period fraud rates are the two properties that most shape our experimental results.}}{5}{table.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:dataset}{{1}{5}{Elliptic Bitcoin Dataset summary. The 7.6:1 training imbalance and the dramatic variation in test-period fraud rates are the two properties that most shape our experimental results}{table.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Dataset characterisation. Top left: illicit rate over all 49 time steps, with the step-34/35 split shown explicitly. Top right: labeled-node counts per time step. Bottom left: overall node-class composition, including the large share of unlabeled transactions. Bottom right: correlation matrix for the ten most important Random Forest features. The figure makes two properties visible at once: the train/test split is temporally non-stationary, and the strongest features are informative without collapsing into a single redundant cluster.}}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:dataset_characterisation}{{1}{5}{Dataset characterisation. Top left: illicit rate over all 49 time steps, with the step-34/35 split shown explicitly. Top right: labeled-node counts per time step. Bottom left: overall node-class composition, including the large share of unlabeled transactions. Bottom right: correlation matrix for the ten most important Random Forest features. The figure makes two properties visible at once: the train/test split is temporally non-stationary, and the strongest features are informative without collapsing into a single redundant cluster}{figure.caption.2}{}}
