\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Main Benchmark}{8}{subsection.5.1}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Main benchmark: F1, Precision, Recall (mean\,$\pm $\,std, 3 seeds). MLP consistently achieves the highest F1. GCN's extreme precision--recall asymmetry (high precision, near-zero recall) is visible on the right panel. Red dashed lines mark the performance targets. GAT error bars are notably wider, reflecting attention instability under severe class imbalance.}}{9}{figure.caption.4}\protected@file@percent }
\newlabel{fig:main_results}{{2}{9}{Main benchmark: F1, Precision, Recall (mean\,$\pm $\,std, 3 seeds). MLP consistently achieves the highest F1. GCN's extreme precision--recall asymmetry (high precision, near-zero recall) is visible on the right panel. Red dashed lines mark the performance targets. GAT error bars are notably wider, reflecting attention instability under severe class imbalance}{figure.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Full benchmark results (mean\,$\pm $\,std, 3 seeds). Bold: column best. MLP dominates F1 and precision. No configuration reaches the 0.75 recall target, the consequence of temporal collapse in steps 43--49. GCN's high precision (0.89--0.93) is misleading: it predicts fraud almost never, making recall 0.29--0.32.}}{9}{table.caption.5}\protected@file@percent }
\newlabel{tab:main_results}{{3}{9}{Full benchmark results (mean\,$\pm $\,std, 3 seeds). Bold: column best. MLP dominates F1 and precision. No configuration reaches the 0.75 recall target, the consequence of temporal collapse in steps 43--49. GCN's high precision (0.89--0.93) is misleading: it predicts fraud almost never, making recall 0.29--0.32}{table.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}How Much Imbalance Handling Changes the Outcome}{9}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Heatmap of F1 (left), Precision (centre), and Recall (right) across all 10 configurations. Green = high, red = low. GCN's column is clearly bi-polar: very green precision, very red recall. MLP shows consistently green F1. The recall heatmap confirms no configuration reaches the 0.75 target.}}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:heatmap}{{3}{10}{Heatmap of F1 (left), Precision (centre), and Recall (right) across all 10 configurations. Green = high, red = low. GCN's column is clearly bi-polar: very green precision, very red recall. MLP shows consistently green F1. The recall heatmap confirms no configuration reaches the 0.75 target}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Strategy deep-dive across architectures. Weighted CE produces the clearest improvement for GCN, modest improvement for GraphSAGE, and mixed improvement for GAT. Graph augmentation improves recall more than precision, which explains why its ranking depends on whether the objective is aggregate F1 or asymmetric business cost.}}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:strategy_deep_dive}{{4}{10}{Strategy deep-dive across architectures. Weighted CE produces the clearest improvement for GCN, modest improvement for GraphSAGE, and mixed improvement for GAT. Graph augmentation improves recall more than precision, which explains why its ranking depends on whether the objective is aggregate F1 or asymmetric business cost}{figure.caption.7}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Statistical Robustness Across Seeds}{11}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Variance across the three training seeds. MLP and GraphSAGE remain comparatively stable across F1, precision, and recall. GAT shows the widest error bars, especially on precision, which is consistent with the higher sensitivity of attention weights to class imbalance and random initialisation.}}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:variance}{{5}{11}{Variance across the three training seeds. MLP and GraphSAGE remain comparatively stable across F1, precision, and recall. GAT shows the widest error bars, especially on precision, which is consistent with the higher sensitivity of attention weights to class imbalance and random initialisation}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Temporal Analysis}{11}{subsection.5.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Mechanism.}{11}{section*.12}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Temporal analysis: F1 per test time step (top) versus true illicit rate (bottom). The vertical dashed line marks the step-42/43 boundary. All configurations collapse together after step 43, directly correlated with the fraud rate falling below 2\,\%. The collapse is driven by the distribution shift, not by architectural differences.}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:temporal_drift}{{6}{12}{Temporal analysis: F1 per test time step (top) versus true illicit rate (bottom). The vertical dashed line marks the step-42/43 boundary. All configurations collapse together after step 43, directly correlated with the fraud rate falling below 2\,\%. The collapse is driven by the distribution shift, not by architectural differences}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Precision-Recall Curves}{12}{subsection.5.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Confusion Matrices}{12}{subsection.5.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.7}Business Cost Analysis}{12}{subsection.5.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Per-class temporal breakdown for SAGE + Weighted CE (left) and SAGE + Graph Aug.\ (right). Recall (blue) falls from 0.74 at step 42 to 0.009 at step 43, a 98.8\,\% drop in one step. Precision (red) nominally holds at 0.15. The predicted fraud rate (orange dotted) tracks the collapse, confirming the model has stopped predicting fraud.}}{13}{figure.caption.11}\protected@file@percent }
\newlabel{fig:perclass}{{7}{13}{Per-class temporal breakdown for SAGE + Weighted CE (left) and SAGE + Graph Aug.\ (right). Recall (blue) falls from 0.74 at step 42 to 0.009 at step 43, a 98.8\,\% drop in one step. Precision (red) nominally holds at 0.15. The predicted fraud rate (orange dotted) tracks the collapse, confirming the model has stopped predicting fraud}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Precision-recall curves (left) and F1 vs classification threshold (right). SAGE configurations achieve higher average precision (AP) than GAT. No single threshold simultaneously delivers precision $>$0.70 and recall $>$0.75 for any configuration, the fundamental constraint imposed by temporal collapse in late steps.}}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:pr_curves}{{8}{13}{Precision-recall curves (left) and F1 vs classification threshold (right). SAGE configurations achieve higher average precision (AP) than GAT. No single threshold simultaneously delivers precision $>$0.70 and recall $>$0.75 for any configuration, the fundamental constraint imposed by temporal collapse in late steps}{figure.caption.13}{}}
\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Per-step metrics for GraphSAGE + Weighted CE. Stable steps (35--42) average F1\,=\,0.799; collapsed steps (43--49) average F1\,=\,0.012. Pred\,\% is the fraction of labeled nodes predicted illicit, confirming that recall collapses because the model stops predicting fraud rather than becoming confused.}}{14}{table.caption.10}\protected@file@percent }
\newlabel{tab:temporal_detail}{{4}{14}{Per-step metrics for GraphSAGE + Weighted CE. Stable steps (35--42) average F1\,=\,0.799; collapsed steps (43--49) average F1\,=\,0.012. Pred\,\% is the fraction of labeled nodes predicted illicit, confirming that recall collapses because the model stops predicting fraud rather than becoming confused}{table.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.8}Training Dynamics}{14}{subsection.5.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Confusion matrices on the full test set (steps 35--49, labeled nodes only). TP = top-left. SAGE misses fewer fraud cases (FN\,=\,388) than GAT (FN\,=\,500--529). GAT + Graph Aug.\ has the most false alarms (FP\,=\,558) but catches the most fraud cases among the three GAT configurations.}}{15}{figure.caption.14}\protected@file@percent }
\newlabel{fig:confusion}{{9}{15}{Confusion matrices on the full test set (steps 35--49, labeled nodes only). TP = top-left. SAGE misses fewer fraud cases (FN\,=\,388) than GAT (FN\,=\,500--529). GAT + Graph Aug.\ has the most false alarms (FP\,=\,558) but catches the most fraud cases among the three GAT configurations}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Business cost analysis (FN\,=\,\$50k per missed fraud, FP\,=\,\$2k per false alert). Left: cost breakdown. Centre: total cost in \$M. Right: fraud catch rate. GAT + Graph Aug.\ achieves the lowest total cost (\$18.5M) despite a lower aggregate F1 than SAGE, because it catches 83 more true fraud cases with only 103 additional false alarms under the 25:1 cost asymmetry.}}{16}{figure.caption.15}\protected@file@percent }
\newlabel{fig:business_cost}{{10}{16}{Business cost analysis (FN\,=\,\$50k per missed fraud, FP\,=\,\$2k per false alert). Left: cost breakdown. Centre: total cost in \$M. Right: fraud catch rate. GAT + Graph Aug.\ achieves the lowest total cost (\$18.5M) despite a lower aggregate F1 than SAGE, because it catches 83 more true fraud cases with only 103 additional false alarms under the 25:1 cost asymmetry}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Training dynamics. Training F1 (dashed) saturates near 0.98 while test F1 (solid) plateaus at 0.55--0.70. The gap opens around epoch 50, the point at which models begin memorising training-period structural signatures rather than learning transferable fraud features.}}{17}{figure.caption.16}\protected@file@percent }
\newlabel{fig:training_curves}{{11}{17}{Training dynamics. Training F1 (dashed) saturates near 0.98 while test F1 (solid) plateaus at 0.55--0.70. The gap opens around epoch 50, the point at which models begin memorising training-period structural signatures rather than learning transferable fraud features}{figure.caption.16}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {section}{\numberline {6}Analysis}{18}{section.6}\protected@file@percent }
\newlabel{sec:analysis}{{6}{18}{Analysis}{section.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Why the MLP Outperforms GNNs}{18}{subsection.6.1}\protected@file@percent }
\newlabel{sec:why_mlp}{{6.1}{18}{Why the MLP Outperforms GNNs}{subsection.6.1}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {6.1.1}Graph structure helps briefly, then turns into a liability}{18}{subsubsection.6.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Per-step GraphSAGE advantage over the MLP baseline. Positive values indicate that the GNN is ahead; negative values indicate that the MLP is ahead. Before the step-42/43 regime change, GraphSAGE often matches or slightly exceeds the MLP. After the collapse boundary, the sign flips and the MLP becomes more reliable, even though absolute F1 is low for all models in that region.}}{18}{figure.caption.17}\protected@file@percent }
\newlabel{fig:ablation_advantage}{{12}{18}{Per-step GraphSAGE advantage over the MLP baseline. Positive values indicate that the GNN is ahead; negative values indicate that the MLP is ahead. Before the step-42/43 regime change, GraphSAGE often matches or slightly exceeds the MLP. After the collapse boundary, the sign flips and the MLP becomes more reliable, even though absolute F1 is low for all models in that region}{figure.caption.17}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {6.1.2}Feature Attribution: Local Features Carry the Discrimination}{18}{subsubsection.6.1.2}\protected@file@percent }
\newlabel{sec:feature_importance}{{6.1.2}{18}{Feature Attribution: Local Features Carry the Discrimination}{subsubsection.6.1.2}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Random Forest feature importance. Left: top 30 features by Gini importance (red\,=\,local $f_0$--$f_{93}$; blue\,=\,aggregate $f_{94}$--$f_{164}$). Local features dominate the high-importance end. Right: cumulative importance, top 17 features explain 50\,\% of importance; top 45 explain 80\,\%. The most important single feature (f54, importance 0.056) is a local transaction feature.}}{19}{figure.caption.18}\protected@file@percent }
\newlabel{fig:feature_importance}{{13}{19}{Random Forest feature importance. Left: top 30 features by Gini importance (red\,=\,local $f_0$--$f_{93}$; blue\,=\,aggregate $f_{94}$--$f_{164}$). Local features dominate the high-importance end. Right: cumulative importance, top 17 features explain 50\,\% of importance; top 45 explain 80\,\%. The most important single feature (f54, importance 0.056) is a local transaction feature}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {6.1.3}Community Structure: Present but Temporally Fragile}{19}{subsubsection.6.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Ego-graph analysis (100 samples per class). Fraud nodes cluster: 54\,\% fraudulent neighbours, subgraph density 0.615. Licit nodes are dispersed: 0.56\,\% fraudulent neighbours, density 0.570. The 96$\times $ neighbour-fraud-fraction ratio is a genuine structural signal that GNNs learn, and that becomes misleading once fraud patterns shift.}}{19}{figure.caption.19}\protected@file@percent }
\newlabel{fig:community}{{14}{19}{Ego-graph analysis (100 samples per class). Fraud nodes cluster: 54\,\% fraudulent neighbours, subgraph density 0.615. Licit nodes are dispersed: 0.56\,\% fraudulent neighbours, density 0.570. The 96$\times $ neighbour-fraud-fraction ratio is a genuine structural signal that GNNs learn, and that becomes misleading once fraud patterns shift}{figure.caption.19}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Calibration Cannot Fix the Collapse}{20}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Temperature scaling. Left: fitted temperatures $T \in [1.07, 1.27]$ confirm mild overconfidence, as expected from training on 11.6\,\% fraud. Right: $\Delta $F1 post-calibration. Every configuration shows $\Delta $F1\,=\,0.000, proving that temperature scaling cannot address the structural temporal collapse.}}{20}{figure.caption.20}\protected@file@percent }
\newlabel{fig:temperature}{{15}{20}{Temperature scaling. Left: fitted temperatures $T \in [1.07, 1.27]$ confirm mild overconfidence, as expected from training on 11.6\,\% fraud. Right: $\Delta $F1 post-calibration. Every configuration shows $\Delta $F1\,=\,0.000, proving that temperature scaling cannot address the structural temporal collapse}{figure.caption.20}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}EvolveGCN: Why Hardware Matters}{20}{subsection.6.3}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces EvolveGCN hardware analysis. Left: F1 comparison across all methods and hardware conditions. Our CPU EvolveGCN (F1\,=\,0.29) falls 0.48 points below the published GPU result (F1\,=\,0.77). Right: EvolveGCN's training curve plateaus early, consistent with the GRU failing to learn smooth weight dynamics from only 8 sampled snapshots.}}{21}{figure.caption.21}\protected@file@percent }
\newlabel{fig:evolvegcn}{{16}{21}{EvolveGCN hardware analysis. Left: F1 comparison across all methods and hardware conditions. Our CPU EvolveGCN (F1\,=\,0.29) falls 0.48 points below the published GPU result (F1\,=\,0.77). Right: EvolveGCN's training curve plateaus early, consistent with the GRU failing to learn smooth weight dynamics from only 8 sampled snapshots}{figure.caption.21}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}Comparison with Published Work}{21}{section.7}\protected@file@percent }
\newlabel{sec:prior_work}{{7}{21}{Comparison with Published Work}{section.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Comparison with prior Elliptic Dataset work. Gray bars: prior work (GPU, transductive evaluation). Coloured bars: our work (CPU, inductive). Our MLP (red) matches Alarab et al.\ (2020) despite stricter evaluation conditions. The SAGE gap vs.\ Lo et al.\ (2023) is largely attributable to the transductive vs.\ inductive protocol difference.}}{21}{figure.caption.22}\protected@file@percent }
\newlabel{fig:prior_work}{{17}{21}{Comparison with prior Elliptic Dataset work. Gray bars: prior work (GPU, transductive evaluation). Coloured bars: our work (CPU, inductive). Our MLP (red) matches Alarab et al.\ (2020) despite stricter evaluation conditions. The SAGE gap vs.\ Lo et al.\ (2023) is largely attributable to the transductive vs.\ inductive protocol difference}{figure.caption.22}{}}
\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Prior Elliptic Dataset work. All prior studies use transductive evaluation on GPU hardware. Our inductive CPU protocol is methodologically stricter. Our MLP is competitive with the best prior-work GNN result despite these disadvantages.}}{22}{table.caption.23}\protected@file@percent }
\newlabel{tab:prior_work}{{5}{22}{Prior Elliptic Dataset work. All prior studies use transductive evaluation on GPU hardware. Our inductive CPU protocol is methodologically stricter. Our MLP is competitive with the best prior-work GNN result despite these disadvantages}{table.caption.23}{}}
